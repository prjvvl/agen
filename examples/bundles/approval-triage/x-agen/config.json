{
  "kind": "singleton",
  "budget": {
    "maxTokensPerRun": 40000,
    "maxUsdPerDay": 0.5
  },
  "permissions": {
    "default": "deny",
    "rules": [
      {
        "tool": "agen.list_approvals",
        "action": "allow"
      },
      {
        "tool": "agen.get_transcript",
        "action": "allow"
      },
      {
        "tool": "agen.get_trace",
        "action": "allow"
      },
      {
        "tool": "agen.get_task",
        "action": "allow"
      },
      {
        "tool": "agen.decide_approval",
        "action": "deny"
      }
    ]
  },
  "triggers": [
    {
      "type": "cron",
      "name": "triage",
      "schedule": "*/10 * * * *",
      "input": "Triage the pending approvals."
    }
  ]
}
