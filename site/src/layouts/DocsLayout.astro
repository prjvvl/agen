---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/url";
import { siteConfig } from "../site.config";
import type { SidebarGroup } from "../lib/docs";

interface Props {
  title: string;
  description: string;
  id: string;
  sourcePath: string;
  groups: SidebarGroup[];
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { title, description, id, sourcePath, groups, prev, next } = Astro.props;
const href = (page: string) => withBase(`/${page}/`);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex max-w-6xl gap-10 px-4 py-10">
    <aside class="hidden w-56 shrink-0 md:block">
      <nav class="sticky top-20 flex flex-col gap-6 text-sm" aria-label="Documentation">
        {
          groups.map(({ group, items }) => (
            <div>
              <p class="font-display font-semibold text-fg">{group}</p>
              <ul class="mt-2 flex flex-col gap-1 border-l border-border">
                {items.map((item) => (
                  <li>
                    <a
                      href={href(item.id)}
                      aria-current={item.id === id ? "page" : undefined}
                      class:list={[
                        "-ml-px block border-l py-1 pl-3",
                        item.id === id
                          ? "border-brand font-medium text-fg"
                          : "border-transparent text-fg-muted hover:border-border hover:text-fg",
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <article class="min-w-0 flex-1">
      <details class="mb-6 rounded-card border border-border px-4 py-2 text-sm md:hidden">
        <summary class="cursor-pointer font-medium text-fg">All pages</summary>
        <div class="mt-3 flex flex-col gap-4 pb-2">
          {
            groups.map(({ group, items }) => (
              <div>
                <p class="font-semibold text-fg">{group}</p>
                {items.map((item) => (
                  <a href={href(item.id)} class="block py-1 text-fg-muted hover:text-fg">
                    {item.title}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </details>

      <div class="prose max-w-none">
        <slot />
      </div>

      <footer class="mt-12 flex flex-col gap-6 border-t border-border pt-6 text-sm">
        <div class="flex justify-between gap-4">
          {prev ? <a href={href(prev.id)} class="text-fg-muted hover:text-fg">&larr; {prev.title}</a> : <span />}
          {next && <a href={href(next.id)} class="text-right text-fg-muted hover:text-fg">{next.title} &rarr;</a>}
        </div>
        <a href={`${siteConfig.repo}/blob/main/${sourcePath}`} class="text-fg-muted hover:text-fg" rel="noopener noreferrer">
          Edit this page on GitHub
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>
