---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../site.config";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase("/og-image.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Blocking on purpose: this has to run before first paint, or the
      // page flashes the wrong theme for a frame. Only acts when the
      // visitor made an explicit choice (ThemeToggle.astro); otherwise
      // prefers-color-scheme governs via CSS alone, no JS needed.
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") {
        document.documentElement.dataset.theme = theme;
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <meta name="theme-color" content="#2331c7" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // A copy button and a language label on every code block; re-run
      // after ClientRouter swaps pages. The icons are Lucide's copy/check.
      const copyIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
      const checkIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
      const setLabel = (button: HTMLButtonElement, icon: string, text: string) => {
        button.innerHTML = `${icon}<span>${text}</span>`;
      };

      document.addEventListener("astro:page-load", () => {
        for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
          if (pre.parentElement?.classList.contains("code-block")) continue;
          const wrap = document.createElement("div");
          wrap.className = "code-block";
          const lang = pre.dataset.language;
          if (lang && !["text", "plaintext", "txt"].includes(lang)) wrap.dataset.lang = lang;
          pre.replaceWith(wrap);
          wrap.append(pre);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code";
          button.setAttribute("aria-label", "Copy code");
          setLabel(button, copyIcon, "Copy");
          button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(pre.innerText.trimEnd());
            setLabel(button, checkIcon, "Copied");
            setTimeout(() => setLabel(button, copyIcon, "Copy"), 1500);
          });
          wrap.append(button);
        }
      });
    </script>
  </body>
</html>
