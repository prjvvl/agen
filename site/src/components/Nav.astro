---
import { Menu, X } from "@lucide/astro";
import { siteConfig } from "../site.config";
import { withBase } from "../lib/url";
import { icons } from "../lib/icons";
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "./GitHubIcon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || "/" : Astro.url.pathname;
const items = siteConfig.nav.map((item) => ({
  ...item,
  Icon: icons[item.icon],
  current: item.match.some((prefix) => path.startsWith(prefix)),
}));
---

<header
  class="sticky top-0 z-20 border-b border-border bg-bg/80 backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top)"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6"
    style="padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right))"
  >
    <a href={withBase("/")} class="flex items-center gap-2.5 font-display text-lg font-semibold text-fg">
      <img src={withBase("/favicon.svg")} alt="" width="28" height="28" class="size-7" />
      {siteConfig.name}
    </a>

    <nav class="hidden flex-1 items-center gap-1 md:flex" aria-label="Main">
      {
        items.map(({ label, href, Icon, current }) => (
          <a
            href={withBase(href)}
            aria-current={current ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm",
              current ? "bg-surface font-medium text-fg" : "text-fg-muted hover:bg-surface hover:text-fg",
            ]}
          >
            <Icon class:list={["size-4", current ? "text-link" : "opacity-70"]} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={siteConfig.repo}
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-fg-muted hover:text-fg"
        aria-label="Agen on GitHub"
        rel="noopener noreferrer"
      >
        <GitHubIcon class="size-5" />
      </a>
      <ThemeToggle />

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-fg md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-menu-mobile"
      >
        <Menu id="nav-icon-open" class="size-6" aria-hidden="true" />
        <X id="nav-icon-close" class="hidden size-6" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Animated via max-height, measured to the content's real scrollHeight
       in the script below rather than a fixed class, so a longer nav list
       never gets silently clipped and the transition never looks like it
       stops early. -->
  <nav
    id="nav-menu-mobile"
    class="max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-out md:hidden"
    aria-label="Main"
    inert
  >
    <div class="flex flex-col gap-1 border-t border-border px-4 py-3">
      {
        items.map(({ label, href, Icon, current }) => (
          <a
            href={withBase(href)}
            aria-current={current ? "page" : undefined}
            class:list={[
              "flex min-h-11 items-center gap-3 rounded-md px-3 text-sm",
              current ? "bg-surface font-medium text-fg" : "text-fg-muted hover:bg-surface hover:text-fg",
            ]}
          >
            <Icon class:list={["size-4", current ? "text-link" : "opacity-70"]} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // Delegated on `document`, not bound directly to #nav-toggle, so this
  // keeps working after Astro's ClientRouter swaps the page body.
  document.addEventListener("click", (event) => {
    const toggle = (event.target as HTMLElement)?.closest("#nav-toggle");
    if (!toggle) return;

    const menu = document.getElementById("nav-menu-mobile");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    const expanded = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!expanded));
    if (menu) {
      menu.style.maxHeight = expanded ? "0px" : `${menu.scrollHeight}px`;
    }
    menu?.classList.toggle("opacity-0", expanded);
    menu?.classList.toggle("opacity-100", !expanded);
    // Collapsing the height hides the menu visually, but the links stay
    // keyboard-focusable and screen-reader-visible unless removed from the
    // accessibility tree explicitly.
    menu?.toggleAttribute("inert", expanded);
    iconOpen?.classList.toggle("hidden", !expanded);
    iconClose?.classList.toggle("hidden", expanded);
  });
</script>
