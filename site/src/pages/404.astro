---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm font-semibold text-brand">404</p>
    <h1 class="mt-2 text-2xl font-bold text-fg">Page not found</h1>
    <p class="mt-3 text-fg-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex justify-center">
      <Button href="/">Back home</Button>
    </div>
  </section>
</BaseLayout>
