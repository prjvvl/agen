{
  "kind": "singleton",
  "budget": {
    "maxTokensPerRun": 60000,
    "maxUsdPerDay": 0.5
  },
  "permissions": {
    "default": "deny",
    "rules": [
      {
        "tool": "agen.get_activity",
        "action": "allow"
      },
      {
        "tool": "agen.get_logs",
        "action": "allow"
      },
      {
        "tool": "agen.get_task",
        "action": "allow"
      },
      {
        "tool": "agen.get_trace",
        "action": "allow"
      },
      {
        "tool": "agen.get_deployment",
        "action": "allow"
      },
      {
        "tool": "agen.get_metrics",
        "action": "allow"
      },
      {
        "tool": "agen.list_tasks",
        "action": "allow"
      },
      {
        "tool": "agen.list_deployments",
        "action": "allow"
      },
      {
        "tool": "agen.list_runs",
        "action": "allow"
      },
      {
        "tool": "agen.list_instances",
        "action": "allow"
      },
      {
        "tool": "agen.who_am_i",
        "action": "allow"
      }
    ]
  },
  "triggers": [
    {
      "type": "cron",
      "name": "check",
      "schedule": "*/30 * * * *",
      "input": "Check the fleet."
    },
    {
      "type": "cron",
      "name": "daily",
      "schedule": "0 8 * * *",
      "input": "Write the daily report."
    }
  ]
}
