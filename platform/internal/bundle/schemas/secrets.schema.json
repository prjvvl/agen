{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agen.dev/schemas/bundle/secrets.schema.json",
  "title": "x-agen/secrets.json — names only, never values",
  "type": "object",
  "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
  "additionalProperties": {
    "type": "object",
    "required": ["source"],
    "properties": {
      "source": { "enum": ["env", "keychain", "platform"] },
      "key": { "type": "string", "description": "lookup key if different from the name" }
    },
    "additionalProperties": false
  }
}
