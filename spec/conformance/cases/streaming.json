{
  "name": "streaming",
  "description": "Text streams as delta events and matches the final output.",
  "agent": {
    "name": "c",
    "provider": {
      "type": "fake",
      "responses": [
        {
          "text": "one two three four five"
        }
      ]
    }
  },
  "runs": [
    {
      "input": "go"
