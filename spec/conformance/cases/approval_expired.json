{
  "name": "approval_expired",
  "description": "An approval nobody answers expires after approvalTimeoutSeconds; the tool never runs.",
  "agent": {
    "name": "c",
    "permissions": {
      "default": "ask"
    },
    "approvalTimeoutSeconds": 1,
    "provider": {
      "type": "fake",
      "responses": [
        {
          "toolCalls": [
            {
              "name": "pay",
              "arguments": {
                "to": "bob"
              }
            }
          ]
        },
        {
          "text": "expired",
          "expect": "not approved (expired)"
        }
      ]
    }
  },
  "tools": [
    {
      "name": "pay",
      "behavior": {
        "return": "sent"
      }
    }
  ],
  "approvals": "hang",
  "runs": [
    {
      "input": "go"
    }
  ],
  "expect": [
    {
      "status": "succeeded",
      "output": "expired",
      "toolCalls": [],
      "maxWallMs": 5000
    }
  ]
}
