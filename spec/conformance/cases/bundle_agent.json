{
  "name": "bundle_agent",
  "description": "Agents load from a bundle directory (path relative to the repo root).",
  "features": ["agent.bundle"],
  "agent": {
    "bundle": "examples/bundles/hello"
  },
  "runs": [
    {
      "input": "hi"
    }
  ],
  "expect": [
    {
      "status": "succeeded",
      "output": "Hello! Nice to meet you."
    }
  ]
}
