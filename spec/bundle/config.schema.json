{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agen.dev/schemas/bundle/config.schema.json",
  "title": "x-agen/config.json",
  "type": "object",
  "properties": {
    "workspace": { "type": "string" },
    "permissions": {
      "type": "object",
      "properties": {
        "default": { "enum": ["allow", "ask", "deny"] },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "action"],
            "properties": {
              "tool": { "type": "string", "description": "exact name or glob, e.g. exchange.*" },
              "action": { "enum": ["allow", "ask", "deny"] }
            },
            "additionalProperties": false
          }
        },
        "approvalTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "notify": {
          "type": "object",
          "description": "POST each new pending approval as JSON to this URL",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "secret": { "type": "string", "description": "Platform secret (agen secrets set) whose value signs the body: X-Agen-Signature: sha256=<hex HMAC>" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "kind": { "enum": ["singleton", "pool", "task"] },
    "scale": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "targetQueuePerInstance": { "type": "integer", "minimum": 1 },
        "idleTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "maxConcurrency": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxTokensPerRun": { "type": "integer", "minimum": 1 },
        "maxUsdPerRun": { "type": "number", "exclusiveMinimum": 0 },
        "maxUsdPerDay": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxDelegationDepth": { "type": "integer", "minimum": 0 },
        "maxFanOut": { "type": "integer", "minimum": 0 },
        "maxTotalDelegations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "oneOf": [
          {
            "properties": {
              "type": { "const": "cron" },
              "name": { "type": "string" },
              "schedule": { "type": "string" },
              "input": { "type": "string" },
              "catchUp": { "type": "boolean" },
              "labels": { "$ref": "#/$defs/labels" }
            },
            "required": ["schedule"],
            "additionalProperties": false
          },
          {
            "properties": {
              "type": { "const": "webhook" },
              "name": { "type": "string" },
              "input": { "type": "string" },
              "auth": {
                "type": "object",
                "description": "How callers prove they hold the trigger's secret (default: bearer)",
                "properties": {
                  "type": { "enum": ["bearer", "hmac"] },
                  "header": { "type": "string", "description": "hmac: header carrying the signature, e.g. X-Hub-Signature-256" },
                  "algorithm": { "enum": ["sha256", "sha1"] },
                  "prefix": { "type": "string", "description": "hmac: text before the hex signature, e.g. sha256=" },
                  "secret": { "type": "string", "description": "hmac: platform secret (agen secrets set) holding the signing key" }
                },
                "required": ["type"],
                "additionalProperties": false
              },
              "idempotencyKey": { "$ref": "#/$defs/keySource", "description": "Where to read the duplicate-protection key (default: Idempotency-Key header)" },
              "conversationKey": { "$ref": "#/$defs/keySource", "description": "Where to read the conversation key" },
              "labels": { "$ref": "#/$defs/labels" }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        ]
      }
    },
    "delegates": {
      "type": "array",
      "description": "Deployments this agent may call over A2A (the call_agent tool)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "namespace": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "object",
      "description": "Per-tool metadata overrides, keyed by server.tool",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sideEffect": { "type": "boolean" },
          "idempotent": { "type": "boolean", "description": "Repeating a call with the same arguments is safe, so an interrupted call is retried instead of ending as effect_unknown" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9._/-]{1,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "keySource": {
      "type": "object",
      "properties": {
        "header": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1, "description": "JSON body field; dots reach nested fields" }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
