{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agen.dev/schemas/bundle/plugin.schema.json",
  "title": "plugin.json (Agent Plugins 1.0 manifest)",
  "type": "object",
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "version": { "type": "string" },
    "description": { "type": "string" }
  },
  "additionalProperties": true
}
